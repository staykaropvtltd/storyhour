# StoryHour Frontend Environment Configuration
# ============================================

# Site Canonical URL
NEXT_PUBLIC_SITE_URL=https://storyhour.co.uk

# Optional External API URL (Internal routes call relative Next.js /api endpoints by default)
NEXT_PUBLIC_API_URL=https://storyhour.co.uk/api

# Email Delivery (Resend API)
RESEND_API_KEY=re_your_resend_api_key_here
CONTACT_TO_EMAIL=contact@storyhour.co.uk

# Supabase Authentication & Database
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Administrator CMS Authentication (REQUIRED: Fail-closed; no fallback credentials)
# ADMIN_SECRET_KEY must be a random secret of at least 32 characters used for HMAC-SHA-256 session tokens
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=your_strong_unique_admin_password
ADMIN_SECRET_KEY=your_random_minimum_32_character_signing_secret_here
