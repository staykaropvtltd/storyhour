# StoryHour Frontend Environment Configuration
NEXT_PUBLIC_SITE_URL=https://storyhour.co.uk
NEXT_PUBLIC_API_URL=https://storyhour.co.uk/api

# Email Delivery (Resend)
RESEND_API_KEY=re_your_resend_api_key_here
CONTACT_TO_EMAIL=contact@storyhour.co.uk

# Supabase Authentication & Database
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Admin CMS Authentication (REQUIRED for production)
ADMIN_EMAIL=admin@storyhour.co.uk
ADMIN_PASSWORD=change_me_to_a_strong_password
ADMIN_SECRET_KEY=change_me_to_a_random_64char_secret
