# StoryHour FastAPI Environment Configuration
# ============================================

# Server Configuration
PROJECT_NAME="StoryHour Backend API"
VERSION="1.0.0"
ENVIRONMENT="development"
HOST="127.0.0.1"
PORT=8001
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# PostgreSQL Database Pool & Timeout (DB-03, DB-04)
# Local development database provided by docker-compose.yml
DATABASE_URL="postgresql+psycopg://postgres:postgres@localhost:5432/storyhour"
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_CONNECT_TIMEOUT=5
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Supabase Credentials
# Kept temporarily for the existing authentication implementation.
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-public-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-secret-key"

# Supabase JWT configuration
# Keep secrets out of source control.
SUPABASE_JWT_SECRET="your-supabase-jwt-secret"
SUPABASE_JWT_ALGORITHM="HS256"

# Phase 6 & Phase 3 Security, Rate Limiting & Performance
RATE_LIMIT_ENABLED=true
RATE_LIMIT_STORAGE="memory"
# REDIS_URL="redis://localhost:6379/0"
CONTACT_RATE_LIMIT_PER_MINUTE=30
AUTH_RATE_LIMIT_PER_MINUTE=30
ANALYTICS_RATE_LIMIT_PER_MINUTE=120
HTTP_CACHE_MAX_AGE_SECONDS=60
ENABLE_HSTS=false
