# StoryHour FastAPI + Supabase Environment Configuration
# =======================================================

# Server Configuration
PROJECT_NAME="StoryHour Backend API"
VERSION="1.0.0"
ENVIRONMENT="development"
HOST="127.0.0.1"
PORT=8001
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Supabase Credentials (Obtain from your Supabase Project Settings -> API)
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-public-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-secret-key"

# Supabase JWT Secret (Settings -> API -> JWT Settings -> JWT Secret)
# Used by FastAPI to cryptographically verify incoming access tokens locally
SUPABASE_JWT_SECRET="your-supabase-jwt-secret"
SUPABASE_JWT_ALGORITHM="HS256"
