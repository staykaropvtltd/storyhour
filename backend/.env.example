# StoryHour FastAPI Environment Configuration
# ============================================

# Server Configuration
PROJECT_NAME="StoryHour Backend API"
VERSION="1.0.0"
ENVIRONMENT="development"
HOST="127.0.0.1"
PORT=8001
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# PostgreSQL Database
# Local development database provided by docker-compose.yml
DATABASE_URL="postgresql+psycopg://postgres:postgres@localhost:5432/storyhour"

# Supabase Credentials
# Kept temporarily for the existing authentication implementation.
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-public-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-secret-key"

# Supabase JWT configuration
# Keep secrets out of source control.
SUPABASE_JWT_SECRET="your-supabase-jwt-secret"
SUPABASE_JWT_ALGORITHM="HS256"
